{
  "name": "qwen-scanner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:wipe": "wrangler d1 execute qwen_scanner --file=./wipe.sql --remote",
    "db:apply": "wrangler d1 execute qwen_scanner --file=./schema.sql --remote",
    "db:apply:local": "wrangler d1 execute qwen_scanner --file=./schema.sql --local",
    "test": "node test/classify.test.js && node test/banks.test.js && node test/engines.test.js && node test/verifier.test.js && node test/finder.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
